# Copie para .env e preencha. .env não é versionado.
OPENAI_API_KEY=
# Modelos padrão (podem ser sobrescritos por chamada)
ENTER_CHAT_MODEL=gpt-4.1-mini
ENTER_EMBED_MODEL=text-embedding-3-small
# Cache em disco das chamadas LLM (reprodutibilidade + custo zero em reexecução)
ENTER_CACHE_DIR=.cache/llm
